{
  "format": "juicer-spec-conformance",
  "format_version": "1.0",
  "spec_version": "1.2",
  "file": "s10-cancel",
  "title": "§10 超时与取消",
  "clauses": ["§10"],
  "scenarios": [
    {
      "id": "S10-01",
      "name": "排队中被调用方放弃：标记撤回、不投递、计入丢弃",
      "spec_refs": ["10.1", "1.3", "1.7"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb"],
      "not_applicable": {"spanner": "Spanner strongstore 客户端没有逐请求超时，没有调用方放弃的路径（规范 10.1 不适用）"},
      "status": "active",
      "purpose": "被挡的写在排队时被取消：标记从堆里消失、处理函数不被调用、丢弃加 1；排在它后面的读在挡人的持有结束时直接放出，不被它（若被放行会登记的持有）挡住。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 2000, "type": "arrive", "msg": "c", "txn": 3, "ts": 300, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 3000, "type": "cancel", "msg": "b"},
        {"t_us": 4000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"]}
      ],
      "end_us": 5000,
      "checkpoint_times": [3500],
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "a", "t_us": 0, "path": "queued"}, {"msg": "c", "t_us": 4000, "path": "queued"}],
        "drops": [{"msg": "b", "t_us": 3000}],
        "releases": {"k1": [{"msg": "a", "t_us": 0}, {"msg": "c", "t_us": 4000}]},
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 4000}},
          {"msg": "c", "key": "k1", "start_us": 4000, "end": "open"}
        ],
        "late": [],
        "checkpoints": [
          {
            "t_us": 3500,
            "managed": ["k1"],
            "draining": [],
            "queue_len": {"k1": 1},
            "held_msgs": ["c"],
            "open_holds": [{"msg": "a", "key": "k1"}],
            "counters": {"intercepted": 3, "direct": 0, "queued_delivered": 1, "dropped": 1, "held_now": 1, "queues_now": 1}
          }
        ],
        "counters": {
          "intercepted": 3,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 1,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 1, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    },
    {
      "id": "S10-02",
      "name": "多 key 消息被放弃：撤回未放行的标记，撤销已登记的持有并唤醒队列",
      "spec_refs": ["10.1", "9.2"],
      "layer": "core",
      "applies_to": ["crdb"],
      "not_applicable": {
        "juicer-cc": "juicer-cc 每个操作一个 RPC、一个 key，没有多 key 消息",
        "spanner": "Spanner strongstore 客户端没有逐请求超时，没有调用方放弃的路径（规范 10.1 不适用）"
      },
      "status": "active",
      "purpose": "多 key 消息在 k1 上已放行并登记持有、在 k2 上还在排队时被取消：k1 上的持有以“撤回”结束，被它挡住的读立刻放出；k2 上的标记撤回；整条消息丢弃。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1", "k2"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "x", "txn": 10, "ts": 5, "ops": [{"key": "k2", "access": "write"}]},
        {
          "t_us": 1000,
          "type": "arrive",
          "msg": "m",
          "txn": 1,
          "ts": 10,
          "ops": [{"key": "k1", "access": "write"}, {"key": "k2", "access": "write"}]
        },
        {"t_us": 2000, "type": "arrive", "msg": "r", "txn": 2, "ts": 20, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 3000, "type": "cancel", "msg": "m"},
        {"t_us": 4000, "type": "control_applied", "txn": 10, "kind": "commit", "keys": ["k2"]}
      ],
      "end_us": 5000,
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "x", "t_us": 0, "path": "queued"}, {"msg": "r", "t_us": 3000, "path": "queued"}],
        "drops": [{"msg": "m", "t_us": 3000}],
        "releases": {"k1": [{"msg": "m", "t_us": 1000}, {"msg": "r", "t_us": 3000}], "k2": [{"msg": "x", "t_us": 0}]},
        "holds": [
          {"msg": "m", "key": "k1", "start_us": 1000, "end": {"reason": "cancel", "t_us": 3000}},
          {"msg": "r", "key": "k1", "start_us": 3000, "end": "open"},
          {"msg": "x", "key": "k2", "start_us": 0, "end": {"reason": "event", "t_us": 4000}}
        ],
        "late": [],
        "counters": {
          "intercepted": 3,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 1,
          "held_now": 0,
          "holds_created": 3,
          "hold_end": {"event": 1, "ttl": 0, "cancel": 1, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 2,
          "queues_now": 2
        }
      }
    },
    {
      "id": "S10-03",
      "name": "Spanner：参与者在 PREPARE_WAIT 中被中止、不回复，也要结束持有",
      "spec_refs": ["10.2", "5.4(b)"],
      "layer": "adapter",
      "applies_to": ["spanner"],
      "not_applicable": {"juicer-cc": "juicer-cc 的并发控制中止事务时总会回复（10.2 不适用）", "crdb": "CockroachDB 不适用（10.2 不适用）"},
      "status": "active",
      "purpose": "事务 1 的准备消息在本参与者上等锁时被中止，存储不会回复它；接入层据此产生“中止执行完”事件，事务 1 的持有结束，被挡的写放出。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "adapter_notes": {"spanner": "默认 --juicer_release_noreply_abort=true；2 ms 事务 1 在 PREPARE_WAIT 中被 wound 或中止、存储不回复它的准备消息。"},
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 2000, "type": "control_applied", "txn": 1, "kind": "abort", "keys": ["k1"], "via": "noreply_abort"},
        {
          "t_us": 3000,
          "type": "control_applied",
          "txn": 2,
          "kind": "commit",
          "keys": ["k1"],
          "via": "participant_decision_applied"
        }
      ],
      "end_us": 4000,
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "a", "t_us": 0, "path": "queued"}, {"msg": "b", "t_us": 2000, "path": "queued"}],
        "drops": [],
        "releases": {"k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 2000}]},
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 2000}},
          {"msg": "b", "key": "k1", "start_us": 2000, "end": {"reason": "event", "t_us": 3000}}
        ],
        "late": [],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 2, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    }
  ]
}
