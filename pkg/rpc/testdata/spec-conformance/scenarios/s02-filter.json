  "file": "s02-filter",
  "title": "§2 热点过滤",
  "clauses": ["§2"],
  "scenarios": [
    {
      "id": "S02-01",
      "name": "候选从同一周期开始被数乱序，周期末才建队列",
      "spec_refs": ["2.2", "2.3", "2.4", "8.1"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb", "spanner"],
      "status": "active",
      "purpose": "key 在周期 0 中途第一次被拒绝成为第一级候选，它在同一周期剩下时间里的乱序到达被计入；周期中途不建队列，周期末建，之后到达的消息才进队。",
      "config": {
        "filter": {"mode": "hotspot", "K": 100, "S": 1, "idle_epochs": 3, "epoch_us": 1000000},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 100000, "type": "level1_abort", "txn": 90, "keys": ["k1"]},
        {"t_us": 200000, "type": "arrive", "msg": "a", "txn": 1, "ts": 500, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 300000, "type": "arrive", "msg": "b", "txn": 2, "ts": 300, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 1000000, "type": "epoch_end"},
        {
          "t_us": 1100000,
          "type": "arrive",
          "msg": "c",
          "txn": 3,
          "ts": 700,
          "ops": [{"key": "k1", "access": "write"}]
        },
        {"t_us": 1101000, "type": "control_applied", "txn": 3, "kind": "commit", "keys": ["k1"]}
      ],
      "end_us": 1200000,
      "checkpoint_times": [500000, 1050000],
      "expect": {
        "startup": "accept",
        "deliveries": [
          {"msg": "a", "t_us": 200000, "path": "direct"},
          {"msg": "b", "t_us": 300000, "path": "direct"},
          {"msg": "c", "t_us": 1100000, "path": "queued"}
        ],
        "drops": [],
        "releases": {"k1": [{"msg": "c", "t_us": 1100000}]},
        "holds": [{"msg": "c", "key": "k1", "start_us": 1100000, "end": {"reason": "event", "t_us": 1101000}}],
        "late": [],
        "queue_events": [{"t_us": 1000000, "key": "k1", "event": "created"}],
        "epochs": [{"index": 0, "ooo": {"k1": 1}}],
        "checkpoints": [
          {
            "t_us": 500000,
            "managed": [],
            "draining": [],
            "queue_len": {},
            "held_msgs": [],
            "open_holds": [],
            "counters": {"intercepted": 2, "direct": 2, "queued_delivered": 0, "dropped": 0, "held_now": 0, "queues_now": 0}
          },
          {
            "t_us": 1050000,
            "managed": ["k1"],
            "draining": [],
            "queue_len": {"k1": 0},
            "held_msgs": [],
            "open_holds": [],
            "counters": {"intercepted": 2, "direct": 2, "queued_delivered": 0, "dropped": 0, "held_now": 0, "queues_now": 1}
          }
        ],
        "counters": {
          "intercepted": 3,
          "direct": 2,
          "queued_delivered": 1,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 1,
          "hold_end": {"event": 1, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
