  "scenarios": [
    {
      "id": "S08-01",
      "name": "撤队列：先停收，已排队的按序经依赖判定放出，堆空即删",
      "spec_refs": ["8.1", "6.4"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb", "spanner"],
      "status": "active",
      "purpose": "k1 连续 3 个周期没有乱序，周期 3 末开始排空时队里有 3 个被挡的写；排空期间新到的写直接投递、不登记持有、不被旧持有挡；3 个写按排序键、各自等挡人者结束才放出；最后一个放出时堆空，队列删除，它刚登记的持有以“队列删除”结束；之后的消息按不受管处理。",
      "config": {
        "filter": {"mode": "hotspot", "K": 100, "S": 1, "idle_epochs": 3, "epoch_us": 1000000},
        "rules": "conflict-table",
        "H_us": 20000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 100000, "type": "level1_abort", "txn": 90, "keys": ["k1"]},
        {
          "t_us": 200000,
          "type": "arrive",
          "msg": "p1",
          "txn": 91,
          "ts": 500,
          "ops": [{"key": "k1", "access": "write"}]
        },
        {
          "t_us": 300000,
          "type": "arrive",
          "msg": "p2",
          "txn": 92,
          "ts": 300,
          "ops": [{"key": "k1", "access": "write"}]
        },
        {"t_us": 1000000, "type": "epoch_end"},
        {"t_us": 2000000, "type": "epoch_end"},
        {"t_us": 3000000, "type": "epoch_end"},
        {
          "t_us": 3990000,
          "type": "arrive",
          "msg": "a",
          "txn": 1,
          "ts": 1000,
          "ops": [{"key": "k1", "access": "write"}]
        },
        {
          "t_us": 3991000,
          "type": "arrive",
          "msg": "b",
          "txn": 2,
          "ts": 1100,
          "ops": [{"key": "k1", "access": "write"}]
        },
