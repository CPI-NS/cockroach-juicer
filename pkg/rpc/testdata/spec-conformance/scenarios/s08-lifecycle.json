          "msg": "d",
          "txn": 4,
          "ts": 1300,
          "ops": [{"key": "k1", "access": "write"}]
        },
        {"t_us": 4000000, "type": "epoch_end"},
        {
          "t_us": 4001000,
          "type": "arrive",
          "msg": "e",
          "txn": 5,
          "ts": 1400,
          "ops": [{"key": "k1", "access": "write"}]
        },
        {"t_us": 4002000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"]},
        {"t_us": 4003000, "type": "control_applied", "txn": 2, "kind": "commit", "keys": ["k1"]},
        {"t_us": 4004000, "type": "control_applied", "txn": 3, "kind": "commit", "keys": ["k1"]},
