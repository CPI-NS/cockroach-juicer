      "status": "active",
      "purpose": "消息碰到受管的 k1 与不受管的 k9：只在 k1 上有标记，k1 放行即整条投递。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
