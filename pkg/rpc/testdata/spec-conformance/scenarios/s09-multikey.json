          "type": "arrive",
          "msg": "m",
          "txn": 1,
          "ts": 10,
          "ops": [{"key": "k1", "access": "write"}, {"key": "k9", "access": "write"}]
        },
        {"t_us": 2000, "type": "control_applied", "txn": 10, "kind": "commit", "keys": ["k1"]},
