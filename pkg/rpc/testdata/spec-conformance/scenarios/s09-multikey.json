        "drops": [],
        "releases": {"k1": [{"msg": "x", "t_us": 0}, {"msg": "m", "t_us": 2000}]},
        "holds": [
          {"msg": "x", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 2000}},
          {"msg": "m", "key": "k1", "start_us": 2000, "end": {"reason": "event", "t_us": 3000}}
        ],
        "late": [],
        "counters": {
