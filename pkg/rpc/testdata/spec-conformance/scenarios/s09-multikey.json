{
  "format": "juicer-spec-conformance",
  "format_version": "1.0",
  "spec_version": "1.2",
  "file": "s09-multikey",
  "title": "§9 多 key 消息与重复访问",
  "clauses": ["§9"],
  "scenarios": [
    {
      "id": "S09-01",
      "name": "多 key 消息的全部标记都放行才整条投递",
      "spec_refs": ["9.1", "9.2"],
      "layer": "core",
      "applies_to": ["crdb", "spanner"],
      "not_applicable": {"juicer-cc": "juicer-cc 每个操作一个 RPC、一个 key，没有多 key 消息"},
      "status": "active",
      "purpose": "消息在 k1、k2 各有一个标记：k1 上立即放行并开始持有，k2 上被挡；整条消息等 k2 放行时才投递。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1", "k2"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "x", "txn": 10, "ts": 5, "ops": [{"key": "k2", "access": "write"}]},
        {
          "t_us": 1000,
          "type": "arrive",
          "msg": "m",
          "txn": 1,
          "ts": 10,
          "ops": [{"key": "k1", "access": "write"}, {"key": "k2", "access": "write"}]
        },
        {"t_us": 3000, "type": "control_applied", "txn": 10, "kind": "commit", "keys": ["k2"]},
        {"t_us": 4000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1", "k2"]}
      ],
      "end_us": 5000,
      "checkpoint_times": [2000],
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "x", "t_us": 0, "path": "queued"}, {"msg": "m", "t_us": 3000, "path": "queued"}],
        "drops": [],
        "releases": {"k1": [{"msg": "m", "t_us": 1000}], "k2": [{"msg": "x", "t_us": 0}, {"msg": "m", "t_us": 3000}]},
        "holds": [
          {"msg": "m", "key": "k1", "start_us": 1000, "end": {"reason": "event", "t_us": 4000}},
          {"msg": "x", "key": "k2", "start_us": 0, "end": {"reason": "event", "t_us": 3000}},
          {"msg": "m", "key": "k2", "start_us": 3000, "end": {"reason": "event", "t_us": 4000}}
        ],
        "late": [],
        "checkpoints": [
          {
            "t_us": 2000,
            "managed": ["k1", "k2"],
            "draining": [],
            "queue_len": {"k1": 0, "k2": 1},
            "held_msgs": ["m"],
            "open_holds": [{"msg": "m", "key": "k1"}, {"msg": "x", "key": "k2"}],
            "counters": {"intercepted": 2, "direct": 0, "queued_delivered": 1, "dropped": 0, "held_now": 1, "queues_now": 2}
          }
        ],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 3,
          "hold_end": {"event": 3, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 2,
          "queues_now": 2
        }
      }
    },
    {
      "id": "S09-02",
      "name": "先放行的标记的持有从它自己放行时计时",
      "spec_refs": ["9.2", "6.1"],
      "layer": "core",
      "applies_to": ["crdb", "spanner"],
      "not_applicable": {"juicer-cc": "juicer-cc 每个操作一个 RPC、一个 key，没有多 key 消息"},
      "status": "active",
      "purpose": "多 key 消息在 k1 上 5 ms 放行、在 k2 上 10 ms 才放行（整条 10 ms 投递）；k1 上的持有按 5 ms 起算，在 15 ms 到期，另一事务在 k1 上的写于 15 ms 放出，而不是 20 ms。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1", "k2"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "x", "txn": 10, "ts": 5, "ops": [{"key": "k2", "access": "write"}]},
        {
          "t_us": 5000,
          "type": "arrive",
          "msg": "m",
          "txn": 1,
          "ts": 10,
          "ops": [{"key": "k1", "access": "write"}, {"key": "k2", "access": "write"}]
        },
        {"t_us": 12000, "type": "arrive", "msg": "y", "txn": 3, "ts": 20, "ops": [{"key": "k1", "access": "write"}]}
      ],
      "end_us": 16000,
      "expect": {
        "startup": "accept",
        "deliveries": [
          {"msg": "x", "t_us": 0, "path": "queued"},
          {"msg": "m", "t_us": 10000, "path": "queued"},
          {"msg": "y", "t_us": 15000, "path": "queued"}
        ],
        "drops": [],
        "releases": {
          "k1": [{"msg": "m", "t_us": 5000}, {"msg": "y", "t_us": 15000}],
          "k2": [{"msg": "x", "t_us": 0}, {"msg": "m", "t_us": 10000}]
        },
        "holds": [
          {"msg": "m", "key": "k1", "start_us": 5000, "end": {"reason": "ttl", "t_us": 15000}},
          {"msg": "y", "key": "k1", "start_us": 15000, "end": "open"},
          {"msg": "x", "key": "k2", "start_us": 0, "end": {"reason": "ttl", "t_us": 10000}},
          {"msg": "m", "key": "k2", "start_us": 10000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 3,
          "direct": 0,
          "queued_delivered": 3,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 4,
          "hold_end": {"event": 0, "ttl": 2, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 2,
          "queues_now": 2
        }
      }
    },
    {
      "id": "S09-03",
      "name": "同一消息对同一 key 的读与写合并成一个写标记",
      "spec_refs": ["9.1"],
      "layer": "core",
      "applies_to": ["crdb", "spanner"],
      "not_applicable": {"juicer-cc": "juicer-cc 每个操作一个 RPC、一个 key，没有多 key 消息"},
      "status": "active",
      "purpose": "一条消息对 k1 既读又写，只产生一个标记、类型取写：只有一个持有，另一事务的读被它挡住（若按读算就不会被挡）。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {
          "t_us": 0,
          "type": "arrive",
          "msg": "m",
          "txn": 1,
          "ts": 10,
          "ops": [{"key": "k1", "access": "read"}, {"key": "k1", "access": "write"}]
        },
        {"t_us": 1000, "type": "arrive", "msg": "r", "txn": 2, "ts": 20, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 2000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"]}
      ],
      "end_us": 3000,
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "m", "t_us": 0, "path": "queued"}, {"msg": "r", "t_us": 2000, "path": "queued"}],
        "drops": [],
        "releases": {"k1": [{"msg": "m", "t_us": 0}, {"msg": "r", "t_us": 2000}]},
        "holds": [
          {"msg": "m", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 2000}},
          {"msg": "r", "key": "k1", "start_us": 2000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 1, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    },
    {
      "id": "S09-04",
