        }
      }
    },
    {
      "id": "S05-05",
      "name": "读改写的读与加锁读按写算",
      "spec_refs": ["5.3", "表5-A 语义冲突"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb"],
      "not_applicable": {"spanner": "Spanner strongstore 的分类器只产生 Get、Set 标记，没有读改写的读或加锁读"},
      "status": "active",
      "purpose": "加锁读（juicer-cc 的 GetForPut、CockroachDB 的加锁读）的持有挡住另一事务的普通读；两个加锁读之间也互挡。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1", "k2"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "lock_read"}]},
        {"t_us": 0, "type": "arrive", "msg": "c", "txn": 3, "ts": 300, "ops": [{"key": "k2", "access": "lock_read"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "read"}]},
        {
          "t_us": 1000,
          "type": "arrive",
          "msg": "d",
          "txn": 4,
          "ts": 400,
          "ops": [{"key": "k2", "access": "lock_read"}]
        },
        {"t_us": 3000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"]},
        {"t_us": 4000, "type": "control_applied", "txn": 3, "kind": "commit", "keys": ["k2"]},
        {"t_us": 4500, "type": "control_applied", "txn": 4, "kind": "commit", "keys": ["k2"]}
      ],
      "end_us": 5000,
      "expect": {
        "startup": "accept",
        "deliveries": [
          {"msg": "a", "t_us": 0, "path": "queued"},
          {"msg": "c", "t_us": 0, "path": "queued"},
          {"msg": "b", "t_us": 3000, "path": "queued"},
          {"msg": "d", "t_us": 4000, "path": "queued"}
        ],
        "drops": [],
        "releases": {
          "k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 3000}],
          "k2": [{"msg": "c", "t_us": 0}, {"msg": "d", "t_us": 4000}]
        },
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 3000}},
          {"msg": "b", "key": "k1", "start_us": 3000, "end": "open"},
          {"msg": "c", "key": "k2", "start_us": 0, "end": {"reason": "event", "t_us": 4000}},
          {"msg": "d", "key": "k2", "start_us": 4000, "end": {"reason": "event", "t_us": 4500}}
        ],
        "late": [],
        "counters": {
          "intercepted": 4,
          "direct": 0,
          "queued_delivered": 4,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 4,
          "hold_end": {"event": 3, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 2,
          "queues_now": 2
        }
      }
    },
    {
      "id": "S05-06",
      "name": "同一事务的标记不互挡，控制类持有在提交执行完时一起结束",
      "spec_refs": ["5.3", "9.4(b)", "9.4(c)"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb"],
      "not_applicable": {"spanner": "Spanner 一个事务在一个分片上只有一条数据消息（准备消息），同一事务不会有第二个标记落在同一 key 上"},
      "status": "active",
      "purpose": "事务 1 在 k1 上先后两条写：第二条在第一条持有期间到达也立即放行；另一事务的读被两条写的持有挡住，回复不结束它们，事务 1 提交执行完时两个持有一起结束。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "write"}]},
        {
          "t_us": 1000,
          "type": "arrive",
          "msg": "b",
          "txn": 1,
          "ts": 150,
          "ops": [{"key": "k1", "access": "write"}],
          "ts_by_system": {"juicer-cc": 100}
        },
        {"t_us": 2000, "type": "arrive", "msg": "c", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 3000, "type": "reply", "msg": "b", "outcome": "ok"},
        {"t_us": 4000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"]}
      ],
      "end_us": 5000,
      "expect": {
        "startup": "accept",
        "deliveries": [
          {"msg": "a", "t_us": 0, "path": "queued"},
          {"msg": "b", "t_us": 1000, "path": "queued"},
          {"msg": "c", "t_us": 4000, "path": "queued"}
        ],
        "drops": [],
        "releases": {"k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 1000}, {"msg": "c", "t_us": 4000}]},
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 4000}},
          {"msg": "b", "key": "k1", "start_us": 1000, "end": {"reason": "event", "t_us": 4000}},
          {"msg": "c", "key": "k1", "start_us": 4000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 3,
          "direct": 0,
          "queued_delivered": 3,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 3,
          "hold_end": {"event": 2, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      },
      "notes": "排序键：CockroachDB 同一事务后一次发送的批头时钟更大（150）；juicer-cc 同一事务的排序键相同（100），由 ts_by_system 给出。两种取值下期望相同。"
    },
    {
      "id": "S05-07",
      "name": "控制类持有：回复返回不结束、提交到达不结束、提交执行完才结束",
