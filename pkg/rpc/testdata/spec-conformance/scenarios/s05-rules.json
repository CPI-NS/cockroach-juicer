    {
      "id": "S05-15",
      "name": "CockroachDB：锚点上的 EndTxn 与 ResolveIntent 各自结束持有，ResolveIntent 事件的事务号取 IntentTxn",
      "spec_refs": ["5.4(b)", "表5-C"],
      "layer": "adapter",
      "applies_to": ["crdb"],
      "status": "active",
      "purpose": "事务 1 的锚点在本节点：EndTxn 执行完结束它在锚点 k1 上的持有；事务 4 的锚点在别的节点，本节点只收得到点名事务 4 的 ResolveIntent（批头不带事务），它执行完结束事务 4 在 k2 上的持有（事件的事务号必须是事务 4，不是 0）。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1", "k2"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "adapter_notes": {
        "crdb": "a 是事务 1 的写批 [Put k1]，锚点 k1 在本节点；e 是事务 4 的写批 [Put k2]，事务 4 的锚点在别的节点，本节点收不到它的 EndTxn；b、c 是事务 2、3 的非加锁读。2 ms 是事务 1 的 EndTxn(commit) 批次（锁区间只含 k1）；3 ms 是不带批头事务、点名 IntentTxn = 事务 4、状态 COMMITTED 的 ResolveIntent 批次。"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 0, "type": "arrive", "msg": "e", "txn": 4, "ts": 110, "ops": [{"key": "k2", "access": "write"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 1000, "type": "arrive", "msg": "c", "txn": 3, "ts": 300, "ops": [{"key": "k2", "access": "read"}]},
        {"t_us": 2000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"], "via": "endtxn_anchor"},
        {"t_us": 3000, "type": "control_applied", "txn": 4, "kind": "commit", "keys": ["k2"], "via": "resolve_intent"}
      ],
      "end_us": 4000,
      "expect": {
        "startup": "accept",
        "deliveries": [
          {"msg": "a", "t_us": 0, "path": "queued"},
          {"msg": "e", "t_us": 0, "path": "queued"},
          {"msg": "b", "t_us": 2000, "path": "queued"},
          {"msg": "c", "t_us": 3000, "path": "queued"}
        ],
        "drops": [],
        "releases": {
          "k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 2000}],
          "k2": [{"msg": "e", "t_us": 0}, {"msg": "c", "t_us": 3000}]
        },
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 2000}},
          {"msg": "b", "key": "k1", "start_us": 2000, "end": "open"},
          {"msg": "e", "key": "k2", "start_us": 0, "end": {"reason": "event", "t_us": 3000}},
          {"msg": "c", "key": "k2", "start_us": 3000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 4,
          "direct": 0,
          "queued_delivered": 4,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 4,
          "hold_end": {"event": 2, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 2,
          "queues_now": 2
        }
      },
      "notes": "b、c 是请求类读，场景里没有它们的回复，它们的持有到结束仍在。锁区间里含本节点其他 range 的点 key 时 EndTxn 算不算这些 key 的“执行完”，见 AMBIGUITIES A15 与 P-07。"
    },
