{
  "format": "juicer-spec-conformance",
  "format_version": "1.0",
  "spec_version": "1.2",
  "file": "s05-rules",
  "title": "§5 依赖执行器与冲突表规则（含表 5-C 各系统“执行完”事件）",
  "clauses": ["§5"],
  "scenarios": [
    {
      "id": "S05-01",
      "name": "读读不挡",
      "spec_refs": ["5.3"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb", "spanner"],
      "status": "active",
      "purpose": "不同事务的两个读：后一个在前一个持有期间到达，立即放行。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "read"}]}
      ],
      "end_us": 2000,
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "a", "t_us": 0, "path": "queued"}, {"msg": "b", "t_us": 1000, "path": "queued"}],
        "drops": [],
        "releases": {"k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 1000}]},
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": "open"},
          {"msg": "b", "key": "k1", "start_us": 1000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 0, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    },
    {
      "id": "S05-02",
      "name": "写挡读（不同事务）",
      "spec_refs": ["5.3", "5.4(b)"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb", "spanner"],
      "status": "active",
      "purpose": "写的持有挡住另一事务的读，直到写所在事务的提交执行完。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 4000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"]}
      ],
      "end_us": 5000,
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "a", "t_us": 0, "path": "queued"}, {"msg": "b", "t_us": 4000, "path": "queued"}],
        "drops": [],
        "releases": {"k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 4000}]},
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 4000}},
          {"msg": "b", "key": "k1", "start_us": 4000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 1, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    },
    {
      "id": "S05-03",
      "name": "读挡写（不同事务），没有任何事件时持有到期放行",
      "spec_refs": ["5.3", "5.1", "6.1"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb", "spanner"],
      "status": "active",
      "purpose": "读的持有挡住另一事务的写；之后没有任何回复或提交事件，写在读持有到期（H = 10 ms）的那一刻被放出，说明被挡的队头按最早到期时刻挂了定时器。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "write"}]}
      ],
      "end_us": 11000,
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "a", "t_us": 0, "path": "queued"}, {"msg": "b", "t_us": 10000, "path": "queued"}],
        "drops": [],
        "releases": {"k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 10000}]},
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "ttl", "t_us": 10000}},
          {"msg": "b", "key": "k1", "start_us": 10000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 0, "ttl": 1, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    },
    {
      "id": "S05-04",
      "name": "写挡写（不同事务）",
      "spec_refs": ["5.3", "5.4(b)"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb", "spanner"],
      "status": "active",
      "purpose": "写的持有挡住另一事务的写，直到前者所在事务的提交执行完。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 0},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 100, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 200, "ops": [{"key": "k1", "access": "write"}]},
        {"t_us": 3000, "type": "control_applied", "txn": 1, "kind": "commit", "keys": ["k1"]},
        {"t_us": 4000, "type": "control_applied", "txn": 2, "kind": "commit", "keys": ["k1"]}
      ],
      "end_us": 5000,
      "expect": {
        "startup": "accept",
        "deliveries": [{"msg": "a", "t_us": 0, "path": "queued"}, {"msg": "b", "t_us": 3000, "path": "queued"}],
        "drops": [],
        "releases": {"k1": [{"msg": "a", "t_us": 0}, {"msg": "b", "t_us": 3000}]},
        "holds": [
          {"msg": "a", "key": "k1", "start_us": 0, "end": {"reason": "event", "t_us": 3000}},
          {"msg": "b", "key": "k1", "start_us": 3000, "end": {"reason": "event", "t_us": 4000}}
        ],
        "late": [],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 2, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
