    {
      "id": "S05-14",
      "name": "juicer-cc：Commit 处理函数返回才结束控制类持有",
      "spec_refs": ["5.4(b)", "表5-C"],
      "layer": "adapter",
      "applies_to": ["juicer-cc"],
      "status": "active",
      "purpose": "Commit RPC 在 2 ms 到达但处理函数拖到 5 ms 才返回；被挡的读在 5 ms 放出，不在提交到达时放出。",
