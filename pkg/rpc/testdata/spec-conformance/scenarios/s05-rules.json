            "held_msgs": ["b"],
            "open_holds": [{"msg": "a", "key": "k1"}],
            "counters": {"intercepted": 2, "direct": 0, "queued_delivered": 1, "dropped": 0, "held_now": 1, "queues_now": 1}
          }
        ],
        "counters": {
          "intercepted": 2,
          "direct": 0,
          "queued_delivered": 2,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 2,
          "hold_end": {"event": 1, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    },
