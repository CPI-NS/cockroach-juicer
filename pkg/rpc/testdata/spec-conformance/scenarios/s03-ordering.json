  "file": "s03-ordering",
  "title": "§3 排序",
  "clauses": ["§3"],
  "scenarios": [
    {
      "id": "S03-01",
      "name": "按排序键出堆",
      "spec_refs": ["3.2", "3.5", "4.2"],
      "layer": "core",
      "applies_to": ["juicer-cc", "crdb", "spanner"],
      "status": "active",
      "purpose": "W = 5 ms，三条读按排序键 30、10、20 先后到达；放行顺序是 10、20、30，每条都不早于自己的进队时刻加 W，排在后面的要等前面的出堆。",
      "config": {
        "filter": {"mode": "fixed", "managed_keys": ["k1"]},
        "rules": "conflict-table",
        "H_us": 10000,
        "buffer": {"policy": "fixed", "W_us": 5000},
        "late_policy": "queue",
        "queue_removal": "drain"
      },
      "inputs": [
        {"t_us": 0, "type": "arrive", "msg": "a", "txn": 1, "ts": 30, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 1000, "type": "arrive", "msg": "b", "txn": 2, "ts": 10, "ops": [{"key": "k1", "access": "read"}]},
        {"t_us": 2000, "type": "arrive", "msg": "c", "txn": 3, "ts": 20, "ops": [{"key": "k1", "access": "read"}]}
      ],
      "end_us": 8000,
      "expect": {
        "startup": "accept",
        "deliveries": [
          {"msg": "b", "t_us": 6000, "path": "queued"},
          {"msg": "c", "t_us": 7000, "path": "queued"},
          {"msg": "a", "t_us": 7000, "path": "queued"}
        ],
        "drops": [],
        "releases": {"k1": [{"msg": "b", "t_us": 6000}, {"msg": "c", "t_us": 7000}, {"msg": "a", "t_us": 7000}]},
        "holds": [
          {"msg": "b", "key": "k1", "start_us": 6000, "end": "open"},
          {"msg": "a", "key": "k1", "start_us": 7000, "end": "open"},
          {"msg": "c", "key": "k1", "start_us": 7000, "end": "open"}
        ],
        "late": [],
        "counters": {
          "intercepted": 3,
          "direct": 0,
          "queued_delivered": 3,
          "dropped": 0,
          "held_now": 0,
          "holds_created": 3,
          "hold_end": {"event": 0, "ttl": 0, "cancel": 0, "queue_deleted": 0},
          "late_queued": {"read": 0, "write": 0, "lock_read": 0},
          "late_bypass": {"read": 0, "write": 0, "lock_read": 0},
          "queues_max": 1,
          "queues_now": 1
        }
      }
    },
