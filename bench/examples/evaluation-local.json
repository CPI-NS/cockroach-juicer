{
  "schema_version": 1,
  "experiment_id": "crdb-evaluation-local-calibration",
  "system": "crdb",
  "mode": "local",
  "inventory": [
    {
      "id": "local",
      "address": "127.0.0.1",
      "cpus": 8,
      "max_client_processes": 3,
      "roles": [
        "server",
        "client",
        "control"
      ],
      "work_dir": "/tmp/crdb-bench"
    }
  ],
  "topology": {
    "nodes": [
      {
        "id": "n1",
        "host_id": "local",
        "rpc_port": 27357,
        "sql_port": 27358,
        "http_port": 28080
      },
      {
        "id": "n2",
        "host_id": "local",
        "rpc_port": 27367,
        "sql_port": 27368,
        "http_port": 28090
      },
      {
        "id": "n3",
        "host_id": "local",
        "rpc_port": 27377,
        "sql_port": 27378,
        "http_port": 28100
      }
    ],
    "replicas": 3,
    "layout": {
      "hot_ranks": 16,
      "lease_nodes": [
        "n1",
        "n2",
        "n3"
      ],
      "disable_rebalancing": true,
      "monitor_interval_seconds": 0.5
    },
    "metrics": {
      "require_retry_identity": false
    }
  },
  "workload": {
    "name": "ycsbt",
    "keys": 20,
    "transaction_size": 5,
    "zipf": 0.99,
    "distinct_keys": false,
    "read_fraction": 0.5,
    "read_mode": "per_transaction",
    "seed": 42,
    "retries": 0,
    "load_batch_rows": 7
  },
  "load": {
    "mode": "closed",
    "concurrency": 3,
    "processes": 3
  },
  "juicer": {
    "enabled": true,
    "hold_calibration": true,
    "env": {
      "EPOCH_MS": 250,
      "FILTER_K": 16,
      "FILTER_S": 1
    }
  },
  "measurement": {
    "warmup_seconds": 1,
    "duration_seconds": 3,
    "timeout_seconds": 60
  },
  "artifacts": {
    "cockroach": "/absolute/path/to/cockroach-short",
    "sql_client": "/absolute/path/to/crdb-sql-client",
    "source_revision": "REPLACE_WITH_FORK_COMMIT",
    "client_source": "/absolute/path/to/checkout/bench/sqlclient"
  },
  "matrix": {},
  "repeats": 1,
  "runtime": {
    "max_attempts": 1,
    "deadline_seconds": 120,
    "cleanup_margin_seconds": 10,
    "reuse_data": false,
    "unattended": false
  }
}
